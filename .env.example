# ==============================================================================
# AI MOTION STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your local development setup:
#   cp .env.example .env
#
# Documentation: docs/development/ENVIRONMENT_VARIABLES.md
# ==============================================================================

# --- Global & Security ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-in-production-32bytes-minimum
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL Database (Asyncpg / SQLAlchemy 2.0) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# --- Valkey Cache & PubSub (Redis Wire Protocol Compatible) ---
VALKEY_URL=valkey://localhost:6379/0
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# --- Temporal Workflow Orchestration ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-production-queue
TEMPORAL_TLS_ENABLED=false
TEMPORAL_CERT_PATH=
TEMPORAL_KEY_PATH=

# --- Media & Asset Storage (Local / S3 Provider) ---
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage/projects
S3_ENDPOINT_URL=
S3_BUCKET_NAME=motion-studio-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true

# --- AI Engines (Local-First: Ollama & ComfyUI) ---
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
COMFYUI_BASE_URL=http://localhost:8188
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Media & 3D Rendering Engines ---
BLENDER_PATH=blender
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
NVENC_ENABLED=true
GPU_CONCURRENCY_LIMIT=1
REMOTION_OUTPUT_DIR=./storage/renders

# --- Frontend Studio (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_TEMPORAL_WEB_URL=http://localhost:8233
